{
  "overflowPolicy": {
    "_comment": "Ordering of overflow images (no qualifying phenotype). Filename-hinted images anchor at their hinted slot index; unhinted images anchor at unhintedAnchor - between the main-view slots (front/back/side, det0-2) and the detail/label/material slots (det3+), so a detail-hinted file can never jump ahead of the family's main shots. onModelFirst ranks hero-is-human=TRUE images before packshots within the same anchor.",
    "unhintedAnchor": 2.5,
    "onModelFirst": true
  },
  "productTypes": {
    "default": {
      "det0": { "keyword": "front",   "phenotypes": ["front-packshot", "front-on-model-full-product", "diagonal-packshot"] },
      "det1": { "keyword": "back",    "phenotypes": ["back-packshot", "back-on-model-full-product"] },
      "det2": { "keyword": "side",    "phenotypes": ["side-packshot", "side-on-model"] },
      "det3": { "keyword": "detail",  "phenotypes": ["closeup-image"] },
      "det4": { "keyword": "top",     "phenotypes": ["top-packshot"] },
      "det5": { "keyword": "bottom",  "phenotypes": ["bottom-packshot"] },
      "det6": { "keyword": "pack",    "phenotypes": [] },
      "det7": { "keyword": "label",   "phenotypes": ["closeup-image", "illustration-technical-drawing"] }
    },
    "topwear": {
      "det0": { "keyword": "front",     "phenotypes": ["front-on-model-full-product", "ghost-front", "front-packshot"] },
      "det1": { "keyword": "back",      "phenotypes": ["back-on-model-full-product", "ghost-back", "back-packshot"] },
      "det2": { "keyword": "side",      "phenotypes": ["side-on-model", "ghost-side", "side-packshot"] },
      "det3": { "keyword": "detail",    "phenotypes": ["closeup-image"] },
      "det4": { "keyword": "lifestyle", "phenotypes": ["lifestyle-hero"] },
      "det5": { "keyword": "front",     "phenotypes": ["front-on-model-partial"] },
      "det6": { "keyword": "label",     "phenotypes": ["closeup-image"] },
      "det7": { "keyword": "material",  "phenotypes": ["closeup-image", "illustration-technical-drawing"] }
    },
    "bottomwear": {
      "det0": { "keyword": "front",     "phenotypes": ["front-on-model-full-product", "ghost-front", "front-packshot"] },
      "det1": { "keyword": "back",      "phenotypes": ["back-on-model-full-product", "ghost-back", "back-packshot"] },
      "det2": { "keyword": "side",      "phenotypes": ["side-on-model", "ghost-side", "side-packshot"] },
      "det3": { "keyword": "detail",    "phenotypes": ["closeup-image"] },
      "det4": { "keyword": "front",     "phenotypes": ["front-on-model-partial"] },
      "det5": { "keyword": "lifestyle", "phenotypes": ["lifestyle-hero"] },
      "det6": { "keyword": "label",     "phenotypes": ["closeup-image"] },
      "det7": { "keyword": "material",  "phenotypes": ["closeup-image", "illustration-technical-drawing"] }
    },
    "footwear": {
      "det0": { "keyword": "diagonal",  "phenotypes": ["diagonal-packshot", "front-on-model-full-product"] },
      "det1": { "keyword": "front",     "phenotypes": ["front-packshot", "front-on-model-partial"] },
      "det2": { "keyword": "side",      "phenotypes": ["side-packshot", "side-on-model"] },
      "det3": { "keyword": "back",      "phenotypes": ["back-packshot"] },
      "det4": { "keyword": "bottom",    "phenotypes": ["bottom-packshot"] },
      "det5": { "keyword": "top",       "phenotypes": ["top-packshot"] },
      "det6": { "keyword": "detail",    "phenotypes": ["closeup-image"] },
      "det7": { "keyword": "lifestyle", "phenotypes": ["lifestyle-hero", "on-model-with-accessories", "illustration-technical-drawing"] }
    },
    "bags-accessories": {
      "det0": { "keyword": "front",     "phenotypes": ["front-packshot", "ghost-front"] },
      "det1": { "keyword": "side",      "phenotypes": ["side-packshot"] },
      "det2": { "keyword": "back",      "phenotypes": ["back-packshot"] },
      "det3": { "keyword": "top",       "phenotypes": ["top-packshot"] },
      "det4": { "keyword": "interior",  "phenotypes": ["interior-shot"] },
      "det5": { "keyword": "detail",    "phenotypes": ["closeup-image"] },
      "det6": { "keyword": "lifestyle", "phenotypes": ["lifestyle-hero", "on-model-with-accessories"] },
      "det7": { "keyword": "label",     "phenotypes": ["closeup-image", "illustration-technical-drawing"] }
    }
  }
}
