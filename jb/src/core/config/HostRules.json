{
  "allowedSchemes": ["http", "https"],
  "blockedSchemes": ["ftp"],
  "blockedHostPatterns": ["reddit.com", "*.reddit.com"],
  "redirects": {
    "allowGenericDirectFileRedirects": false,
    "allowFetcherOwnedRedirects": true
  },
  "networkRanges": {
    "allowPrivate": true,
    "allowLinkLocal": true,
    "allowLoopback": false,
    "rejectAnyLoopbackDnsResult": true
  },
  "timeouts": {
    "connectSeconds": 10,
    "responseHeaderSeconds": 15,
    "idleReadSeconds": 15,
    "totalFetchSeconds": 120
  },
  "weTransferPolling": {
    "consentClickTimeoutMs": 5000,
    "consentHiddenWaitTimeoutMs": 10000,
    "consentSettleDelayMs": 300,
    "downloadButtonClickTimeoutMs": 10000,
    "downloadWaitTimeoutMs": 60000,
    "streamBufferSizeBytes": 81920,
    "maxDownloadGb": 10,
    "consentBannerPasses": 2
  },
  "testing": {
    "allowLocalhost": false
  }
}
