{
  "_comment": "Canonical PRISM image taxonomy. Source of truth for feature ids, their allowed values, and the phenotype catalogue. Sourced from jb/docs/ImageNGP/ImageFeatures.md and imagePhenotypes.md. ImageRoles.json, DetOrderRules.json, and ClipPrompts.json are validated against this file at startup (ImageNgpValidator). enum/boolean features constrain their values list; integer/float/string features validate by datatype only. UNKNOWN/unknown is always an accepted value.",

  "features": [
    { "id": "has-human",                "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "human-count",              "datatype": "integer" },
    { "id": "hero-is-human",            "datatype": "enum",    "values": ["TRUE", "FALSE", "UNKNOWN"] },
    { "id": "has-head",                 "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "head-visible",             "datatype": "enum",    "values": ["FULL", "PARTIAL", "NONE", "UNKNOWN"] },
    { "id": "has-face",                 "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "face-visible",             "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "body-visible",             "datatype": "enum",    "values": ["full", "three-quarter", "half", "bust", "none", "unknown"] },
    { "id": "skin-tone-area",           "datatype": "float" },
    { "id": "pose-type",                "datatype": "enum",    "values": ["standing", "sitting", "crouching", "lying", "unknown"] },

    { "id": "hero-orientation",         "datatype": "enum",    "values": ["FRONT", "DIAGONAL", "SIDEON", "BACK", "TOP", "BOTTOM", "UNKNOWN"] },
    { "id": "front-view",               "datatype": "boolean", "values": ["true", "false"] },
    { "id": "side-view",                "datatype": "boolean", "values": ["true", "false"] },
    { "id": "rear-view",                "datatype": "boolean", "values": ["true", "false"] },
    { "id": "top-view",                 "datatype": "boolean", "values": ["true", "false"] },
    { "id": "camera-angle",             "datatype": "enum",    "values": ["eye-level", "low-angle", "high-angle", "overhead", "unknown"] },
    { "id": "symmetry-score",           "datatype": "float" },

    { "id": "background-type",          "datatype": "enum",    "values": ["SOLIDCOLOR", "STUDIO", "REALLIFE", "UNKNOWN"] },
    { "id": "white-background",         "datatype": "boolean", "values": ["true", "false"] },
    { "id": "clipping-path",            "datatype": "boolean", "values": ["true", "false"] },
    { "id": "transparent-background",   "datatype": "boolean", "values": ["true", "false"] },
    { "id": "lifestyle-background",     "datatype": "boolean", "values": ["true", "false"] },
    { "id": "indoor",                   "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "outdoor",                  "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "shadow-present",           "datatype": "boolean", "values": ["true", "false"] },
    { "id": "reflection-present",       "datatype": "boolean", "values": ["true", "false"] },
    { "id": "background-color",         "datatype": "string" },

    { "id": "intersects-top",           "datatype": "boolean", "values": ["true", "false"] },
    { "id": "intersects-bottom",        "datatype": "boolean", "values": ["true", "false"] },
    { "id": "intersects-left",          "datatype": "boolean", "values": ["true", "false"] },
    { "id": "intersects-right",         "datatype": "boolean", "values": ["true", "false"] },
    { "id": "intersection-count",       "datatype": "integer" },
    { "id": "fully-in-frame",           "datatype": "boolean", "values": ["true", "false"] },

    { "id": "type-of-shot",             "datatype": "enum",    "values": ["PACKSHOT", "ONMODEL", "GHOST", "FLAT", "DETAIL", "LIFESTYLE", "STILLIFE", "UNKNOWN"] },
    { "id": "occlusion-level",          "datatype": "enum",    "values": ["full-product", "mostly-visible", "partially-occluded", "closeup", "unknown"] },
    { "id": "crop-tightness",           "datatype": "float" },
    { "id": "product-coverage-ratio",   "datatype": "float" },
    { "id": "image-occupancy",          "datatype": "float" },
    { "id": "overlap-count",            "datatype": "integer" },
    { "id": "multiple-products",        "datatype": "boolean", "values": ["true", "false", "unknown"] },

    { "id": "lighting",                 "datatype": "enum",    "values": ["EASY", "HARD", "UNKNOWN"] },
    { "id": "lighting-detail",          "datatype": "enum",    "values": ["flat", "directional", "high-key", "low-key", "mixed", "unknown"] },
    { "id": "overexposed",              "datatype": "boolean", "values": ["true", "false"] },
    { "id": "underexposed",             "datatype": "boolean", "values": ["true", "false"] },

    { "id": "text-present",             "datatype": "boolean", "values": ["true", "false"] },
    { "id": "logo-present",             "datatype": "boolean", "values": ["true", "false"] },
    { "id": "packaging-visible",        "datatype": "boolean", "values": ["true", "false"] },
    { "id": "scale-reference-present",  "datatype": "boolean", "values": ["true", "false"] },
    { "id": "dominant-colors",          "datatype": "string" },
    { "id": "product-color",            "datatype": "string" },
    { "id": "material-texture-visible", "datatype": "boolean", "values": ["true", "false"] },
    { "id": "contains-mannequin",       "datatype": "boolean", "values": ["true", "false", "unknown"] },
    { "id": "product-type-label",       "datatype": "string" },

    { "id": "aspect-ratio",             "datatype": "float" },
    { "id": "product-aspect-ratio",     "datatype": "float" },
    { "id": "salient-bbox",             "datatype": "string" },
    { "id": "vertical-centering",       "datatype": "float" },
    { "id": "horizontal-centering",     "datatype": "float" }
  ],

  "phenotypes": [
    "front-packshot",
    "back-packshot",
    "side-packshot",
    "diagonal-packshot",
    "top-packshot",
