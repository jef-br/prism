    "side-on-model",
    "ghost-front",
    "ghost-back",
    "ghost-side",
    "flatlay-front",
    "flatlay-styled",
    "closeup-image",
    "packaging-shot",
    "lifestyle-hero",
    "lifestyle-context",
    "scale-reference-shot",
    "illustration-technical-drawing",
    "model-detail-closeup",
    "sitting-on-model",
    "on-model-with-accessories",
    "interior-shot",
    "size-chart"
  ]
}
