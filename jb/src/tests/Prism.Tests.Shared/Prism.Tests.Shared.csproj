<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Fixture classlib, not a test project: keeps sln-level `dotnet test` from spawning a testhost for it. -->
    <IsTestProject>false</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Prism.Core.csproj" />
    <ProjectReference Include="..\..\core\Models\Prism.Core.Contracts.csproj" />
  </ItemGroup>

</Project>
