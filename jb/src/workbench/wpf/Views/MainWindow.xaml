<Window x:Class="Prism.Workbench.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prism.Workbench.Wpf.Controls"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="720"
        MinWidth="880"
        MinHeight="560"
        Background="{StaticResource WorkbenchBackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource WorkbenchSidebarBrush}"
            BorderBrush="{StaticResource WorkbenchBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="24">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="PRISM"
                     Foreground="{StaticResource WorkbenchHeadingBrush}"
                     FontSize="30"
                     FontWeight="SemiBold" />
          <TextBlock Text="WPF Workbench"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource WorkbenchMutedTextBrush}"
                     FontSize="14" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                Margin="0,24,0,0"
                Padding="14"
                CornerRadius="6"
                Background="{StaticResource WorkbenchPanelBrush}"
                BorderBrush="{StaticResource WorkbenchBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Core Boundary"
                       Foreground="{StaticResource WorkbenchHeadingBrush}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CoreStatus}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WorkbenchMutedTextBrush}" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Workbench Surface"
                   Foreground="{StaticResource WorkbenchHeadingBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Text="No PRISM job is running. Select local inputs after the core adapter is wired."
                   Margin="0,6,0,0"
                   Foreground="{StaticResource WorkbenchMutedTextBrush}" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,28,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,18,0"
                Padding="18"
                CornerRadius="6"
                Background="{StaticResource WorkbenchPanelBrush}"
                BorderBrush="{StaticResource WorkbenchBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Definitive Route"
                       Foreground="{StaticResource WorkbenchHeadingBrush}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding RouteStages}"
                          Margin="0,16,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <controls:RouteStageControl />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="18"
                CornerRadius="6"
                Background="{StaticResource WorkbenchPanelBrush}"
                BorderBrush="{StaticResource WorkbenchBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Manifest Diagnostics"
                       Foreground="{StaticResource WorkbenchHeadingBrush}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="Manifest-backed route, evidence, KO, and output details will appear here after a real PRISM job completes."
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WorkbenchMutedTextBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
