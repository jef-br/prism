<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WorkbenchBackgroundColor">#F3F1EC</Color>
  <Color x:Key="WorkbenchSidebarColor">#202722</Color>
  <Color x:Key="WorkbenchPanelColor">#FFFDF8</Color>
  <Color x:Key="WorkbenchSurfaceColor">#F7F4ED</Color>
  <Color x:Key="WorkbenchBorderColor">#D9D2C5</Color>
  <Color x:Key="WorkbenchHeadingColor">#18211C</Color>
  <Color x:Key="WorkbenchMutedTextColor">#687266</Color>

  <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="{StaticResource WorkbenchBackgroundColor}" />
  <SolidColorBrush x:Key="WorkbenchSidebarBrush" Color="{StaticResource WorkbenchSidebarColor}" />
  <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="{StaticResource WorkbenchPanelColor}" />
  <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="{StaticResource WorkbenchSurfaceColor}" />
  <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="{StaticResource WorkbenchBorderColor}" />
  <SolidColorBrush x:Key="WorkbenchHeadingBrush" Color="{StaticResource WorkbenchHeadingColor}" />
  <SolidColorBrush x:Key="WorkbenchMutedTextBrush" Color="{StaticResource WorkbenchMutedTextColor}" />
</ResourceDictionary>
